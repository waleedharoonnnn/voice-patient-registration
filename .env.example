# Copy to .env and fill in real values locally. Never commit .env.

APP_ENV=dev
LOG_LEVEL=INFO
LOG_PII=false

# Neon pooled endpoint (PgBouncer, transaction mode) — used by the app.
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb
# Neon direct (non-pooled) endpoint — used by Alembic migrations only.
DATABASE_URL_DIRECT=postgresql+asyncpg://user:password@ep-xxxx.region.aws.neon.tech/neondb
# Local Docker Compose Postgres (see docker-compose.yml) — used only by integration tests.
TEST_DATABASE_URL=postgresql+asyncpg://voiceai:voiceai@localhost:5544/voiceai_test

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# false only for local Docker Postgres (no SSL support); Neon always needs true.
DB_SSL_REQUIRE=true

# Random secrets you generate yourself (not issued by Neon or Vapi), e.g.:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
API_KEY=changeme
VAPI_WEBHOOK_SECRET=changeme
# Vapi dashboard -> Private API key (NOT the public key).
VAPI_API_KEY=

DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=changeme

CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_DEFAULT=60/minute
# Hardening toggles — defaults shown. Set ENABLE_API_DOCS=false to hide /docs in prod;
# ENABLE_HSTS=true only when served over HTTPS.
ENABLE_API_DOCS=true
ENABLE_HSTS=false
MAX_REQUEST_BODY_BYTES=2000000

# Not read by the app — kept here only so .env.example mirrors .env.
Auth_Token=

# Only needed to run `make sync-vapi` (scripts/sync_vapi.py), not to serve traffic.
# PUBLIC_BASE_URL is the ngrok (or deployed) URL the Vapi webhook must be reachable at.
PUBLIC_BASE_URL=https://your-ngrok-domain.ngrok-free.dev
# Display only (README/testing); not read by the app. E.164 format.
PUBLIC_PHONE_NUMBER=+10000000000
VAPI_PHONE_NUMBER_ID=
# Optional voice-stack rollback (JSON objects; leave commented out to use vapi/assistant.json).
# Transcriber/voice replace the whole block; model is merged. See docs/adr/0006.
# VAPI_TRANSCRIBER_OVERRIDE={"provider":"deepgram","model":"nova-3","language":"multi"}
# VAPI_MODEL_OVERRIDE={"model":"gpt-4o-mini"}
# VAPI_VOICE_OVERRIDE={"provider":"cartesia","model":"sonic-3.5","voiceId":"c894559e-d529-4d70-a6fb-3330ecf7ef6b"}

# Optional tuning — defaults shown.
VAPI_TOOL_TIMEOUT_SECONDS=8.0
VAPI_WEBHOOK_DB_STATEMENT_TIMEOUT_MS=5000
# Mock appointment availability + dashboard display timezone (IANA name).
CLINIC_TIMEZONE=America/New_York
