# Copy to .env and fill in real values locally. Never commit .env.

APP_ENV=dev
LOG_LEVEL=INFO
LOG_PII=false

# Neon pooled endpoint (PgBouncer, transaction mode) — used by the app.
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname
# Neon direct (non-pooled) endpoint — used by Alembic migrations only.
DATABASE_URL_DIRECT=postgresql+asyncpg://user:password@host/dbname
# Local Docker Compose Postgres (see docker-compose.yml) — used only by integration tests.
TEST_DATABASE_URL=postgresql+asyncpg://voiceai:voiceai@localhost:5544/voiceai_test

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

API_KEY=changeme
VAPI_WEBHOOK_SECRET=changeme
VAPI_API_KEY=

DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=admin

CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_DEFAULT=60/minute
