{
  "name": "Sarah - Patient Registration",
  "firstMessage": "Thanks for calling! This is Sarah, here to help you register as a new patient. Can I start with your full name?",
  "firstMessageInterruptionsEnabled": true,
  "model": {
    "provider": "openai",
    "model": "gpt-4.1",
    "temperature": 0.3,
    "messages": [
      {
        "role": "system",
        "content": "$SYSTEM_PROMPT"
      }
    ],
    "toolIds": "$TOOL_IDS"
  },
  "transcriber": {
    "provider": "assembly-ai",
    "speechModel": "universal-streaming-english",
    "language": "en",
    "languageDetection": false,
    "formatTurns": true,
    "confidenceThreshold": 0.4,
    "disablePartialTranscripts": false,
    "keytermsPrompt": [
      "date of birth",
      "insurance",
      "emergency contact",
      "apartment",
      "suite",
      "ZIP code"
    ]
  },
  "voice": {
    "provider": "cartesia",
    "model": "sonic-3.5",
    "voiceId": "f91ab3e6-5071-4e15-b016-cde6f2bcd222"
  },
  "backgroundSound": "office",
  "backgroundSpeechDenoisingPlan": {
    "smartDenoisingPlan": {
      "enabled": true
    }
  },
  "startSpeakingPlan": {
    "waitSeconds": 0.6,
    "transcriptionEndpointingPlan": {
      "onPunctuationSeconds": 0.5,
      "onNoPunctuationSeconds": 1.2,
      "onNumberSeconds": 3.0
    },
    "smartEndpointingPlan": {
      "provider": "livekit",
      "waitFunction": "20 + 500 * sqrt(x) + 2500 * x^3"
    },
    "customEndpointingRules": [
      {
        "type": "assistant",
        "regex": "(phone|number|date of birth|birthday|zip|spell|member id|email)",
        "regexOptions": [{ "type": "ignore-case", "enabled": true }],
        "timeoutSeconds": 1.5
      },
      {
        "type": "customer",
        "regex": "(\\d|\\b[A-Za-z])[\\s,.-]*$",
        "timeoutSeconds": 1.5
      }
    ]
  },
  "stopSpeakingPlan": {
    "numWords": 3,
    "voiceSeconds": 0.4,
    "backoffSeconds": 0.8
  },
  "maxDurationSeconds": 900,
  "silenceTimeoutSeconds": 3600,
  "endCallMessage": "Thanks for calling, take care.",
  "endCallPhrases": ["have a great day", "take care", "goodbye"],
  "serverMessages": ["tool-calls", "end-of-call-report", "status-update"],
  "server": {
    "url": "$PUBLIC_BASE_URL/vapi/webhook",
    "headers": {
      "X-Vapi-Secret": "$VAPI_WEBHOOK_SECRET"
    }
  },
  "artifactPlan": {
    "recordingEnabled": true,
    "transcriptPlan": {
      "enabled": true
    }
  },
  "analysisPlan": {
    "summaryPlan": {
      "enabled": true
    }
  }
}
