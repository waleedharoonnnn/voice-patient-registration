{
  "name": "Sarah - Patient Registration",
  "firstMessage": "Thanks for calling! This is Sarah, the virtual assistant here to help you register as a new patient. Can I start with your full name?",
  "firstMessageInterruptionsEnabled": true,
  "model": {
    "provider": "openai",
    "model": "gpt-4o-mini",
    "temperature": 0.3,
    "messages": [
      {
        "role": "system",
        "content": "$SYSTEM_PROMPT"
      }
    ],
    "toolIds": "$TOOL_IDS"
  },
  "transcriber": {
    "provider": "deepgram",
    "model": "nova-3",
    "language": "multi",
    "smartFormat": true,
    "numerals": true,
    "keyterm": [
      "date of birth",
      "insurance",
      "emergency contact",
      "apartment",
      "suite",
      "ZIP code"
    ]
  },
  "voice": {
    "provider": "openai",
    "voiceId": "alloy",
    "model": "gpt-4o-mini-tts"
  },
  "backgroundSound": "office",
  "backgroundSpeechDenoisingPlan": {
    "smartDenoisingPlan": {
      "enabled": true
    }
  },
  "startSpeakingPlan": {
    "waitSeconds": 0.8,
    "transcriptionEndpointingPlan": {
      "onPunctuationSeconds": 0.5,
      "onNoPunctuationSeconds": 1.2,
      "onNumberSeconds": 3.0
    }
  },
  "stopSpeakingPlan": {
    "numWords": 2,
    "voiceSeconds": 0.3,
    "backoffSeconds": 1.0
  },
  "maxDurationSeconds": 900,
  "endCallMessage": "Thanks for calling, take care.",
  "endCallPhrases": ["have a great day", "take care", "goodbye"],
  "serverMessages": ["tool-calls", "end-of-call-report", "status-update"],
  "server": {
    "url": "$PUBLIC_BASE_URL/vapi/webhook",
    "headers": {
      "X-Vapi-Secret": "$VAPI_WEBHOOK_SECRET"
    }
  },
  "artifactPlan": {
    "recordingEnabled": true,
    "transcriptPlan": {
      "enabled": true
    }
  },
  "analysisPlan": {
    "summaryPlan": {
      "enabled": true
    }
  }
}
