{
  "name": "update_patient",
  "description": "Update fields on an existing patient record, after find_patient_by_phone has identified them. Requires the caller to restate their date of birth to verify identity before any change is applied.",
  "parameters": {
    "type": "object",
    "properties": {
      "patient_id": {
        "type": "string",
        "description": "The patient_id returned by find_patient_by_phone."
      },
      "date_of_birth": {
        "type": "string",
        "description": "Date of birth as MM/DD/YYYY, restated by the caller to verify identity."
      },
      "fields": {
        "type": "object",
        "description": "Only the fields being changed, e.g. {\"phone_number\": \"2125550123\"}.",
        "properties": {
          "first_name": { "type": "string" },
          "last_name": { "type": "string" },
          "date_of_birth": { "type": "string" },
          "sex": {
            "type": "string",
            "enum": ["Male", "Female", "Other", "Decline to Answer"]
          },
          "phone_number": { "type": "string" },
          "email": { "type": "string" },
          "address_line_1": { "type": "string" },
          "address_line_2": { "type": "string" },
          "city": { "type": "string" },
          "state": { "type": "string" },
          "zip_code": { "type": "string" },
          "insurance_provider": { "type": "string" },
          "insurance_member_id": { "type": "string" },
          "preferred_language": { "type": "string" },
          "emergency_contact_name": { "type": "string" },
          "emergency_contact_phone": { "type": "string" }
        }
      }
    },
    "required": ["patient_id", "date_of_birth", "fields"]
  }
}
